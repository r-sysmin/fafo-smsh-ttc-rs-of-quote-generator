{
  "version": 1,
  "sdk_version": "3.0.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://sxpdamzprqfnwlwraapy.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "fafo-smsh-ttc-rs-of-quote-generator",
      "version": "0.1.0",
      "title": "FAFO-SMSH/TTC/RS of Quote Generator"
    },
    "tools": [
      {
        "name": "list_proposals",
        "title": "List proposals",
        "description": "List proposals (quotes) visible to the signed-in user, newest first, optionally filtered by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "draft",
                    "sent",
                    "viewed",
                    "accepted",
                    "rejected",
                    "expired"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional status filter."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum number of proposals to return (default 25)."
            }
          },
          "required": [
            "status",
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_proposal",
        "title": "Get proposal",
        "description": "Get one proposal with its line items, by proposal id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "proposal_id": {
              "type": "string",
              "format": "uuid",
              "description": "The proposal id."
            }
          },
          "required": [
            "proposal_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_clients",
        "title": "List clients",
        "description": "List clients in the signed-in user's organization, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional name or company text to filter by."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum number of clients to return (default 25)."
            }
          },
          "required": [
            "search",
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_client",
        "title": "Create client",
        "description": "Create a new client record in the signed-in user's organization.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Client contact name."
            },
            "company": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Company name, if any."
            },
            "email": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "email"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Contact email, if any."
            },
            "phone": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Contact phone, if any."
            },
            "notes": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Internal notes, if any."
            }
          },
          "required": [
            "name",
            "company",
            "email",
            "phone",
            "notes"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_templates",
        "title": "List templates",
        "description": "List proposal templates available to the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum number of templates to return (default 50)."
            }
          },
          "required": [
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
